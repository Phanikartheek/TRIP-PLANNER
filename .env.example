# Groq API key (free tier) — get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Active Groq Model (Fast, high throughput Qwen 3.8 27B on Groq)
TRIP_PLANNER_MODEL=groq/qwen/qwen3.6-27b

# Resend API Key for Magic Link email login (Optional, free from https://resend.com)
# If unset, magic links will be logged directly to the server console for local testing.
RESEND_API_KEY=

# --- PRODUCTION (Railway) variables ---
# Path to SQLite database on persistent volume. Leave blank for local dev (auto-detected).
# Railway: set to /data/jobs.db  (after attaching a Volume mounted at /data)
DB_PATH=

# Comma-separated list of allowed CORS origins.
# Local dev default: http://localhost:8000,http://127.0.0.1:8000
# Railway: set to https://your-app.up.railway.app  (your actual Railway domain)
ALLOWED_ORIGINS=




